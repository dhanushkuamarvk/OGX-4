# ==============================================================================
# Co-Plan (Resurrect 2026, Problem 3) — Environment Configuration
# Copy this file to .env and configure your LLM provider & API key.
# BOTH Co-Plan (treatment) and Baseline (control) read these exact settings.
# ==============================================================================

# Provider options: mock | openai | anthropic | gemini | openai_compatible
LLM_PROVIDER=mock
LLM_MODEL=mock-coplan-v1
LLM_API_KEY=
# Optional custom base URL (for OpenRouter, Groq, Ollama, LiteLLM, vLLM, etc.)
LLM_BASE_URL=

# Shared generation parameters (IDENTICAL across Co-Plan and Baseline)
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TOP_P=1.0
LLM_TIMEOUT_SECONDS=60.0

# Streaming pacing for observable mid-flight steering in mock mode (0 in tests)
COPLAN_STEP_DELAY_MS=140

# Persistence & Telemetry paths
DB_PATH=./data/coplan.db
TELEMETRY_DIR=./eval/raw_logs
TASKS_PATH=./eval/tasks/tasks.json

# Server ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BASELINE_PORT=8001
COPLAN_FRONTEND_PORT=5173
BASELINE_FRONTEND_PORT=5174
