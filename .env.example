# ==============================================================================
# RELAY AI — Environment Variables
# Copy this file to .env.local and provide your credentials.
# If keys are omitted, RELAY AI runs seamlessly in clearly labeled DEMO MODE.
# ==============================================================================

# Google Gemini API (Server-side only — NEVER expose to client)
GEMINI_API_KEY=

# Optional: Gemini Model Override (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Supabase Service Role Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=
